---
/**
 * BaseLayout.astro — HTML shell for every page.
 *
 * Props:
 *   title        Page <title> (required). Format: "Page Name | Cut List Calculator"
 *   description  <meta description> (optional, falls back to site tagline)
 *   canonicalUrl Full canonical URL (optional, set when you know it)
 *
 * Slots:
 *   default      Page body content (between header and footer)
 *   head-extra   Extra <head> tags (JSON-LD, etc.)
 */

import { base } from '../lib/base';
import t from '../i18n/en.json';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = t['site.tagline'],
  canonicalUrl,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- No-flash theme: runs before first paint so the page starts in the right theme. -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (_) {}
        var pref = stored === 'light' ? 'light'
                 : stored === 'dark'  ? 'dark'
                 : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark'
                 : 'light';
        document.documentElement.setAttribute('data-theme', pref);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Shared favicons (icons added in P0-T05) -->
    <link rel="icon" href={base('/favicon.svg')} type="image/svg+xml" />

    <slot name="head-extra" />
  </head>

  <body>
    <!-- Skip link: first interactive element, jumps keyboard focus to main content -->
    <a class="skip-link" href="#main-content">{t['nav.skipToMain']}</a>

    <!-- ===== HEADER ===== -->
    <header class="site-header" role="banner">
      <div class="container site-header__inner">

        <!-- Logo / wordmark -->
        <a href={base('/')} class="site-logo" aria-label={t['site.name']}>
          <!-- Brand mark: two rectangles suggesting a cut sheet -->
          <svg
            class="site-logo__mark"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="2"  y="2"  width="13" height="9"  rx="1" fill="currentColor" />
            <rect x="9"  y="13" width="13" height="9"  rx="1" fill="currentColor" opacity="0.6" />
          </svg>
          <span class="site-logo__text">{t['site.name']}</span>
        </a>

        <!-- Tool switcher: populated as tools go live (empty until P1) -->
        <nav class="tool-nav" aria-label={t['nav.tools']}>
          <ul class="tool-nav__list" role="list">
            <!-- P1 will add: <li><a href={base('/linear')} aria-current="page">Linear cutting</a></li> -->
          </ul>
        </nav>

        <!-- Theme toggle: Light / Dark -->
        <div class="theme-toggle" role="group" aria-label={t['nav.themeLabel']}>
          <button
            class="theme-btn"
            data-theme-value="light"
            aria-pressed="false"
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1"  x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22"  x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1"  y1="12" x2="3"  y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
            </svg>
            <span>{t['nav.themeLight']}</span>
          </button>

          <button
            class="theme-btn"
            data-theme-value="dark"
            aria-pressed="false"
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <span>{t['nav.themeDark']}</span>
          </button>
        </div>

      </div>
    </header>

    <!-- ===== MAIN ===== -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="site-footer" role="contentinfo">
      <div class="container site-footer__inner">
        <nav class="footer-nav" aria-label={t['footer.navLabel']}>
          <ul class="footer-nav__list" role="list">
            <li><a href={base('/about')}>{t['footer.about']}</a></li>
            <li><a href={base('/help')}>{t['footer.help']}</a></li>
            <li><a href={base('/privacy')}>{t['footer.privacy']}</a></li>
          </ul>
        </nav>
        <p class="footer-privacy">
          {t['footer.privacy_note']}
          <a href={base('/about')}>{t['footer.learnMore']}</a>.
        </p>
      </div>
    </footer>

    <!-- Theme toggle script: runs after paint, reads/writes localStorage -->
    <script>
      (function () {
        var STORAGE_KEY = 'theme';

        function getStored(): string | null {
          try { return localStorage.getItem(STORAGE_KEY); } catch { return null; }
        }

        function setStored(value: string): void {
          try { localStorage.setItem(STORAGE_KEY, value); } catch { /* ignore */ }
        }

        function applyTheme(value: string): void {
          document.documentElement.setAttribute('data-theme', value);
          setStored(value);
          // Update aria-pressed on all buttons
          document.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(btn.dataset.themeValue === value));
          });
        }

        // Initial state: use stored preference, or resolve OS preference (but don't store it)
        var stored = getStored();
        var currentTheme: string;
        if (stored === 'light' || stored === 'dark') {
          currentTheme = stored;
        } else {
          // First visit: follow OS, don't save — pressing a button will save the first explicit choice
          currentTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        // Set aria-pressed to reflect actual current theme (without saving if first visit)
        document.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach(function (btn) {
          btn.setAttribute('aria-pressed', String(btn.dataset.themeValue === currentTheme));
        });

        // Wire up buttons: clicking Light or Dark saves and applies
        document.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            applyTheme(btn.dataset.themeValue ?? 'light');
          });
        });

        // Follow OS preference when no choice is saved
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          if (!getStored()) {
            var next = e.matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            document.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach(function (btn) {
              btn.setAttribute('aria-pressed', String(btn.dataset.themeValue === next));
            });
          }
        });
      })();
    </script>

  </body>
</html>

<style>
  /* ===== HEADER ===== */
  .site-header {
    background:    var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position:      sticky;
    top:           0;
    z-index:       100;
  }

  .site-header__inner {
    display:         flex;
    align-items:     center;
    gap:             var(--space-4);
    min-height:      var(--tap-target-min); /* at least 48 px */
    padding-block:   var(--space-3);
  }

  /* Logo */
  .site-logo {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    text-decoration: none;
    color:           var(--color-text);
    flex-shrink:     0;
  }

  .site-logo__mark {
    color: var(--color-brand);
    flex-shrink: 0;
  }

  .site-logo__text {
    font-weight:  var(--weight-heading);
    font-size:    var(--text-body);
    white-space:  nowrap;
    letter-spacing: -0.01em;
  }

  .site-logo:hover .site-logo__text,
  .site-logo:focus-visible .site-logo__text {
    color: var(--color-brand);
  }

  .site-logo:focus-visible {
    outline:        var(--focus-ring);
    outline-offset: var(--focus-offset);
    border-radius:  var(--radius-s);
  }

  /* Tool nav — grows to fill space between logo and theme toggle */
  .tool-nav {
    flex:       1;
    overflow-x: auto;
    scrollbar-width: none;        /* Firefox */
  }

  .tool-nav::-webkit-scrollbar {
    display: none;                /* Chrome / Safari */
  }

  .tool-nav__list {
    display:    flex;
    gap:        var(--space-1);
    list-style: none;
    padding:    0;
    margin:     0;
  }

  .tool-nav__list a {
    display:         inline-flex;
    align-items:     center;
    min-height:      var(--tap-target-min);
    padding-inline:  var(--space-3);
    text-decoration: none;
    font-weight:     var(--weight-label);
    font-size:       var(--text-small);
    color:           var(--color-text-muted);
    border-radius:   var(--radius-s);
    white-space:     nowrap;
    transition:      color var(--duration-fast) var(--easing);
    border-bottom:   3px solid transparent;
  }

  .tool-nav__list a:hover,
  .tool-nav__list a:focus-visible {
    color: var(--color-text);
  }

  .tool-nav__list a:focus-visible {
    outline:        var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* Current tool: bold + underline (using border-bottom so it doesn't shift layout) */
  .tool-nav__list a[aria-current="page"] {
    color:         var(--color-text);
    border-bottom-color: var(--color-brand);
  }

  /* Theme toggle */
  .theme-toggle {
    display:     flex;
    align-items: center;
    gap:         var(--space-1);
    flex-shrink: 0;
    /* Segmented-control look */
    background:    var(--color-bg);
    border:        1px solid var(--color-border);
    border-radius: var(--radius-s);
    padding:       var(--space-1);
  }

  .theme-btn {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-1);
    min-height:      calc(var(--tap-target-min) - var(--space-2));  /* 40 px: inside the wrapper */
    padding-block:   var(--space-1);
    padding-inline:  var(--space-2);
    font-size:       var(--text-caption);
    font-weight:     var(--weight-label);
    color:           var(--color-text-muted);
    background:      transparent;
    border:          none;
    border-radius:   var(--radius-xs);
    cursor:          pointer;
    transition:      background var(--duration-fast) var(--easing),
                     color      var(--duration-fast) var(--easing);
    white-space:     nowrap;
  }

  .theme-btn:hover {
    background: var(--color-surface);
    color:      var(--color-text);
  }

  .theme-btn[aria-pressed="true"] {
    background: var(--color-brand);
    color:      var(--color-on-brand);
  }

  .theme-btn:focus-visible {
    outline:        var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* Hide text labels on very small phones (icon only) */
  @media (max-width: 359px) {
    .theme-btn span { display: none; }
    .site-logo__text { display: none; }
  }

  /* ===== FOOTER ===== */
  .site-footer {
    background:   var(--color-surface);
    border-top:   1px solid var(--color-border);
    padding-block: var(--space-5);
    font-size:    var(--text-small);
    color:        var(--color-text-muted);
  }

  .site-footer__inner {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
  }

  @media (min-width: 640px) {
    .site-footer__inner {
      flex-direction: row;
      align-items:    center;
      justify-content: space-between;
    }
  }

  .footer-nav__list {
    display:    flex;
    flex-wrap:  wrap;
    gap:        var(--space-2) var(--space-4);
    list-style: none;
    padding:    0;
    margin:     0;
  }

  .footer-nav__list a {
    color:      var(--color-text-muted);
    font-size:  var(--text-small);
  }

  .footer-privacy {
    font-size:   var(--text-small);
    color:       var(--color-text-muted);
    max-width:   none;   /* override prose-width on <p> */
  }
</style>
