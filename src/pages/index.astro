---
/**
 * src/pages/index.astro — Flagship Linear Cutting Calculator tool page.
 *
 * Per plan.txt decision D10:
 * The home page "/" is the flagship tool (Linear cutting).
 * It is not a landing page.
 *
 * Uses ToolLayout for the shared title block, "i How to use" button,
 * and below-tool section structure.
 *
 * P1-T08: Stock + settings inputs in the tool slot.
 * P1-T09 will add the pieces list to this same slot.
 * P1-T10 will add the Calculate button and results.
 */
import ToolLayout from '../layouts/ToolLayout.astro';
import LinearSettings from '../components/LinearSettings.astro';
import t from '../i18n/en.json';
---

<ToolLayout
  title={t['linear.title']}
  heading={t['linear.heading']}
  promise={t['linear.promise']}
  description={t['site.tagline']}
>
  <!-- Tool slot: settings + (future) pieces list + calculate + results -->
  <div slot="tool" class="tool-form">
    <LinearSettings />
    <!-- P1-T09 will add <LinearPieces /> here -->
    <!-- P1-T10 will add <LinearCalculate /> and results here -->
  </div>

  <!-- How-to slot: numbered steps -->
  <ol slot="how-to" class="how-to-steps">
    <li>{t['linear.howTo.step1']}</li>
    <li>{t['linear.howTo.step2']}</li>
    <li>{t['linear.howTo.step3']}</li>
    <li>{t['linear.howTo.step4']}</li>
  </ol>
</ToolLayout>

<style>
  /* Tool form wrapper */
  .tool-form {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-5);
  }

  /* How-to numbered list */
  .how-to-steps {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
    padding-inline-start: var(--space-5);
    margin:         0;
    max-width:      var(--prose-width);
  }

  .how-to-steps li {
    font-size:   var(--text-body);
    line-height: var(--leading-body);
    color:       var(--color-text);
  }
</style>
